{
  "version": 1,
  "models": {
    "orders": {
      "source": "raw_orders",
      "description": "One row per order. Revenue is computed from the approved business definition.",
      "primary_key": "order_id",
      "columns": {
        "order_id": {"type": "INTEGER"},
        "customer_id": {"type": "INTEGER"},
        "order_date": {"type": "DATE"},
        "channel": {"type": "VARCHAR"},
        "status": {"type": "VARCHAR"},
        "gross_amount": {"type": "DOUBLE"},
        "refund_amount": {"type": "DOUBLE"},
        "net_revenue": {
          "type": "DOUBLE",
          "expression": "CASE WHEN status = 'completed' THEN gross_amount - refund_amount ELSE 0.0 END"
        }
      }
    },
    "customers": {
      "source": "raw_customers",
      "description": "One row per customer. Join orders to customers on customer_id.",
      "primary_key": "customer_id",
      "columns": {
        "customer_id": {"type": "INTEGER"},
        "customer_name": {"type": "VARCHAR"},
        "region": {"type": "VARCHAR"},
        "segment": {"type": "VARCHAR"}
      }
    }
  }
}
